ANTHROPIC_API_KEY=sk-ant-...
# terraform_agent and security_agent also use this directly (via agents/llm_utils.py)
# to have Claude interpret their local `terraform plan`/`snyk iac test` output.

# pipeline_agent (reads Actions run status) + post_summary_node (writes PR
# review comments) — both via the GitHub remote MCP server.
GITHUB_REPO=owner/repo
# PAT needs repo scope: read access to actions, write access to pull requests/issues.
GITHUB_TOKEN=

# security_agent: `snyk iac test` (standalone CLI binary, no MCP, no npm/Node —
# see README's "Local-only agents" section for the install command). Required;
# skips the scan with a clear message if unset, no silent fallback to another tool.
SNYK_TOKEN=

# Temporal — leave all three unset to default to a local dev server
# (`temporal server start-dev` on localhost:7233), used by every path: CLI,
# web UI, and GitHub Actions (via a self-hosted runner on this same machine —
# see README's "Register a self-hosted runner"). Both temporal_worker.py and
# trigger_workflow.py read these directly, no cloud/secrets-manager involved.
#
# Set TEMPORAL_API_KEY to point at Temporal Cloud instead:
TEMPORAL_ADDRESS=
TEMPORAL_NAMESPACE=
TEMPORAL_API_KEY=
